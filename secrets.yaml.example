# secrets.yaml.example
# Copy this file to secrets.yaml and fill in your values.
# secrets.yaml is gitignored and should NEVER be committed.

wifi_ssid: "YourNetworkName"
wifi_password: "YourWiFiPassword"

# Generate in ESPHome dashboard when creating the device
api_encryption_key: "paste-base64-key-here=="

# Choose any password for OTA updates
ota_password: "your-ota-password"

# Password for the fallback WiFi hotspot (AP mode)
ap_password: "your-ap-password"
